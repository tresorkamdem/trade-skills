//@version=6
// Version backtestable du système de tendance, avec taille de position à risque fixe (module 02)
// et coûts réalistes. Onglet « Strategy Tester » pour les résultats.
strategy("Trade Skills · Stratégie tendance", overlay = true,
     initial_capital = 10000, currency = currency.EUR,
     commission_type = strategy.commission.percent, commission_value = 0.05,
     slippage = 2, pyramiding = 0)

lenTrend  = input.int(200, "Moyenne de tendance")
lenEntry  = input.int(20,  "Donchian entrée")
lenExit   = input.int(10,  "Donchian sortie")
atrLen    = input.int(14,  "ATR")
atrMult   = input.float(2.0, "Stop en ATR", step = 0.5)
riskPct   = input.float(1.0, "Risque par trade (%)", step = 0.25) / 100

trend  = ta.sma(close, lenTrend)
upper  = ta.highest(high, lenEntry)[1]
lower  = ta.lowest(low, lenExit)[1]
atrVal = ta.atr(atrLen)

var float stopPrice = na

if strategy.position_size == 0 and close > trend and close > upper
    stopPrice := close - atrMult * atrVal
    riskPerUnit = close - stopPrice
    qty = math.floor(strategy.equity * riskPct / riskPerUnit)
    if qty > 0
        strategy.entry("Long", strategy.long, qty = qty)

if strategy.position_size > 0
    strategy.exit("Stop", "Long", stop = stopPrice)
    if close < lower
        strategy.close("Long", comment = "Sortie Donchian")

plot(trend, "MM tendance", color = color.orange, linewidth = 2)
plot(strategy.position_size > 0 ? stopPrice : na, "Stop", color = color.red, style = plot.style_linebr)
